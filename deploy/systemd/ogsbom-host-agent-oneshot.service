# Un cycle de l'agent serveur (inscription au besoin, scan, envoi ou signal de vie),
# lancé par ogsbom-host-agent-oneshot.timer. Mêmes protections que le démon.
[Unit]
Description=open-go-sbom host agent (one scan)
Documentation=https://github.com/leblanc-simon/open-go-sbom/blob/main/docs/operations.md
Wants=network-online.target
After=network-online.target
Conflicts=ogsbom-host-agent.service

[Service]
Type=oneshot
Environment=OGSBOM_HOST_AGENT_MODE=oneshot
ExecStart=/usr/bin/ogsbom-host-agent -c /etc/ogsbom-host-agent/config.yaml

User=ogsbom-agent
Group=ogsbom-agent
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
StateDirectory=ogsbom-host-agent
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

Nice=19
IOSchedulingClass=idle
MemoryMax=1536M
#CPUQuota=25%
# Borne le cycle entier (scan.max_duration borne le scan seul).
TimeoutStartSec=2h

#LoadCredentialEncrypted=enrollment-token:/etc/ogsbom-host-agent/enrollment-token.cred
#LoadCredentialEncrypted=client-key:/etc/ogsbom-host-agent/client-key.cred
