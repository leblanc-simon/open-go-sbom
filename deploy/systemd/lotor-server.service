# Unité systemd de lotor-server (voir docs/operations.md, « Installation de production »).
# Les secrets (DSN avec mot de passe, clés de chiffrement) sont dans un fichier
# d'environnement en 0600, lu par systemd avant le changement d'utilisateur.
[Unit]
Description=lotor server
Documentation=https://github.com/leblanc-simon/lotor/blob/main/docs/operations.md
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
ExecStart=/usr/local/bin/lotor-server -c /etc/lotor/config.yaml
EnvironmentFile=/etc/lotor/lotor-server.env
Restart=on-failure
RestartSec=5s
# Plus long que http.shutdown_timeout et workers.shutdown_timeout (30 s chacun).
TimeoutStopSec=45s
# Environ 80 % de la mémoire réservée à l'instance (décodage des SBOM : docs/operations.md).
#Environment=GOMEMLIMIT=6GiB

DynamicUser=yes
# /var/lib/lotor : copie locale de la base de vulnérabilités (vulndb.dir, 8 Gio libres).
StateDirectory=lotor
StateDirectoryMode=0700
# TLS natif : la clé privée (root, 0600) passe par un credential, lu sous
# tls.key_file: /run/credentials/lotor-server.service/tls-key
#LoadCredential=tls-key:/etc/lotor/tls.key

# Aucune capacité. Pour écouter sur un port privilégié (443) en TLS natif, remplacer les
# deux lignes par CapabilityBoundingSet=CAP_NET_BIND_SERVICE et
# AmbientCapabilities=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
